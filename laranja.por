programa {
  funcao inicio() {
    //entendimento do problema
    //infos e variaveis
    inteiro laranja1
    inteiro laranja2
    inteiro resultado
    inteiro total
    //entrada de dados
    escreva("Quantas laranjas você tinha?")
    leia(laranja1)
    escreva("Quantas você tem agora?")
    leia(laranja2)
    //processamento
    resultado = laranja1 - laranja2
    total = resultado
    //saida
    escreva("A quantidade de laranjas vendidas foram: ")
    escreva(total)

  }
}
