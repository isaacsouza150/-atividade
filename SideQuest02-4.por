programa {
  funcao inicio() {
    inteiro numero

    escreva("Escolha um número de 1 a 7, que eu te darei o número em dia da semana: ")
    leia(numero)

    se(numero == 1){
      escreva("1 = Domingo")
    }
    se(numero == 2){
      escreva("2 = Segunda-feira")
    }
    se(numero == 3){
      escreva("3 = Terça-feira")
    }
    se(numero == 4){
      escreva("4 = Quarta-feira")
    }
    se(numero == 5){
      escreva("5 = Quinta-feira")
    }
    se(numero == 6){
      escreva("6 = Sexta-feira")
    }
    se(numero == 7){
      escreva("7 = Sábado")
    }
  }
}
