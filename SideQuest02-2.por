programa {
  funcao inicio() {
    cadeia abracadabra
    inteiro coisa

    escreva("Digite sua senha: ")
    leia(abracadabra)

    se(abracadabra == "abracadabra"){
      escreva("Você descobriu a verdade, parabéns.")
    }
    se(abracadabra != "abracadabra"){
      escreva("Você não sabe da verdade.")
    }
  }
}
