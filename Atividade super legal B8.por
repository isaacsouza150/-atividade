programa {
  funcao inicio() {
    //entendimento
    //infos e variáveis
    inteiro pessoas
    inteiro carne, cerveja, agua, refri
    //entrada de dados
    escreva("Quantidade de pessoas:")
    leia(pessoas)
    //processamento
    carne = pessoas * 0.5
    cerveja = pessoas * 1
    agua = pessoas * 0.5
    refri = pessoas *0.2
    //saída de dados
    escreva("Carne: " + carne)
    escreva("\nCerveja: " + cerveja)
    escreva("\nÁgua: " + agua)
    escreva("\nRefri: " + refri)
  }
}
